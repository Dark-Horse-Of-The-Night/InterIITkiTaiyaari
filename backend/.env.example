# Copy this file to backend/.env and fill in your real API key.
# backend/.env is ignored by Git — never commit real keys.
# Get a Groq key at https://console.groq.com/keys

# --- Stage 1: Speech-to-text ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=your-groq-api-key-here
STT_MODEL=whisper-large-v3

# --- Stage 2: Refiner (fixes misrecognised technical terms) ---
REFINER_BASE_URL=https://api.groq.com/openai/v1
REFINER_API_KEY=your-groq-api-key-here
REFINER_MODEL=openai/gpt-oss-120b

# --- Stage 3: Documenter (builds the structured meeting record) ---
DOCUMENTER_BASE_URL=https://api.groq.com/openai/v1
DOCUMENTER_API_KEY=your-groq-api-key-here
DOCUMENTER_MODEL=openai/gpt-oss-120b

# --- Uploads ---
# Groq's free tier accepts audio files up to 25 MB.
MAX_UPLOAD_MB=25
